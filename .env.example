# Copy to .env and replace placeholders with credentials from Neon Connect.
# Both URLs must refer to the SAME DEVELOPMENT branch, never production.
DATABASE_URL="postgresql://USER:PASSWORD@ep-DEVELOPMENT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-DEVELOPMENT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional: direct URL for a separate disposable shadow database if your role
# cannot create databases. NEVER use your development or production database.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-SHADOW.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
